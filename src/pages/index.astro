---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PortfolioApp from "../components/PortfolioApp";

const name = "Jackson Sebastian";
const role = "Ingeniero Fullstack";
const subrole = "Especializado en Next.js, Astro, Bun, IA y Sistemas Empresariales.";
---

<Layout title="Jackson Sebastian | Portfolio">
	<Navbar client:load />
	<main>
		<PortfolioApp client:load name={name} role={role} subrole={subrole} />
	</main>
</Layout>
